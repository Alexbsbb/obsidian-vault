{
  "swagger": "2.0",
  "info": {
    "title": "ZapSenderAPI",
    "description": "WhatsApp API Server built in Go\nTheme: Orange (#FF4500) & Black (#000000)",
    "version": "1.0.0",
    "contact": {
      "name": "ZapSender Team",
      "url": "https://github.com/zapsender"
    }
  },
  "host": "localhost:8080",
  "basePath": "/api/v1",
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "definitions": {
    "Instance": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["disconnected", "connecting", "connected"] },
        "pushName": { "type": "string" }
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "instanceId": { "type": "string", "format": "uuid" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "default": "text" }
      }
    }
  },
  "paths": {
    "/instances": {
      "post": {
        "tags": ["Instances"],
        "summary": "Create WhatsApp instance",
        "parameters": [
          { "name": "Authorization", "in": "header", "type": "string" },
          { "name": "body", "in": "body", "schema": { "$ref": "#/definitions/Instance" } }
        ],
        "responses": {
          "201": { "description": "Instance created" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/instances/{id}/qr": {
      "get": {
        "tags": ["Instances"],
        "summary": "Get QR code for instance",
        "parameters": [
          { "name": "id", "in": "path", "type": "string" },
          { "name": "Authorization", "in": "header", "type": "string" }
        ],
        "produces": ["image/png"],
        "responses": {
          "200": { "description": "QR Code image" }
        }
      }
    }
  }
}