# ============================================================================
#  ZAPSENDERAPI - WhatsApp API Configuration
#  Theme: Orange (#FF4500) & Black (#000000)
# ============================================================================

# Server Configuration
SERVER_PORT=8080
CLIENT_NAME=ZapSenderAPI
HOST=0.0.0.0

# Security
GLOBAL_API_KEY=your-secure-api-key-here-change-me

# Database (SQLite for simplicity, PostgreSQL for production)
DATABASE_URL=sqlite:///data/instances.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/zapsender?sslmode=disable

# WhatsApp Session
SESSION_DIR=/app/sessions
SESSION_ENCRYPTION=true

# Webhook Settings
WEBHOOK_CONCURRENCY=10
WEBHOOK_TIMEOUT=30s
MAX_RETRIES=3

# Media Storage
STORAGE_TYPE=local  # or "minio" or "s3"
MEDIA_PATH=/app/media

# MinIO Configuration (if using MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=whatsapp-media

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW=1h
RATE_LIMIT_MAX=1000

# CORS
CORS_ORIGINS=*

# Bot Settings
BOT_ENABLED=true
BOT_AUTO_RESPOND=false

# Telegram Integration (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Integration (for notifications)
DISCORD_WEBHOOK_URL=

# Slack Integration (for notifications)
SLACK_WEBHOOK_URL=